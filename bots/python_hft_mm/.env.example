# =====================================================================
# HFT Market Maker Bot Environment Configuration
# =====================================================================

# Exchange Target ('DIMONEX', 'BINANCE', 'BYBIT', 'SIMULATOR')
EXCHANGE=DIMONEX

# Trading Pair (Base: 8 decimals, Quote: 6 decimals e.g., USDT)
SYMBOL=BTC-USDT
BASE_ASSET=BTC
QUOTE_ASSET=USDT

# WebSocket & REST Endpoints
WS_URL=wss://api.dimonex.id/ws/v1/market
REST_URL=https://api.dimonex.id/api/v1

# Secure API Credentials (HMAC-SHA256)
API_KEY=your_production_api_key_here
API_SECRET=your_production_api_secret_here

# Asset & Engine Precisions
BASE_DECIMALS=8
QUOTE_DECIMALS=6
TICK_SIZE=0.01
LOT_SIZE=0.0001

# Market Making Parameters
TARGET_SPREAD_PCT=0.08
MIN_SPREAD_PCT=0.02
MAX_SPREAD_PCT=0.40
MICRO_ORDER_SIZE=0.001
MAX_LADDER_LEVELS=3

# Inventory Ceilings & Risk Thresholds
MAX_BASE_INVENTORY=5.0
MAX_QUOTE_INVENTORY=50000.0
INVENTORY_SKEW_FACTOR=0.25
MAX_DRAWDOWN_PCT=3.0

# Anti-Manipulation / Flash Defense
VOLATILITY_THRESHOLD_BPS=120
PUMP_DUMP_MULTIPLIER=2.5
DEFENSE_PERIMETER_MULTIPLIER=3.0
WS_TIMEOUT_SECONDS=4.0
